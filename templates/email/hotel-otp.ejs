<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        
        body { 
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0; 
            padding: 20px; 
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            color: #334155;
            line-height: 1.6;
        }
        .container { 
            max-width: 600px; 
            margin: 0 auto; 
            background: #ffffff; 
            border-radius: 16px; 
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            overflow: hidden;
            border: 1px solid #e2e8f0;
        }
        .header { 
            background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
            color: #ffffff;
            padding: 48px 40px;
            text-align: center;
            position: relative;
        }
        .header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="%23ffffff" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>') repeat;
            opacity: 0.3;
        }
        .logo { 
            font-size: 32px; 
            font-weight: 700; 
            margin-bottom: 8px;
            letter-spacing: 1px;
            position: relative;
            z-index: 1;
        }
        .subtitle { 
            font-size: 16px; 
            font-weight: 400;
            opacity: 0.9;
            margin: 0;
            position: relative;
            z-index: 1;
        }
        .content { 
            padding: 48px 40px;
        }
        .greeting { 
            font-size: 20px; 
            font-weight: 600;
            color: #1e293b; 
            margin-bottom: 24px;
        }
        .message { 
            color: #475569; 
            font-size: 16px;
            line-height: 1.7; 
            margin-bottom: 32px;
        }
        .otp-container { 
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 2px solid #3b82f6;
            border-radius: 16px;
            padding: 40px 32px;
            text-align: center;
            margin: 32px 0;
            position: relative;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .otp-container::before {
            content: '🏨';
            position: absolute;
            top: -16px;
            left: 50%;
            transform: translateX(-50%);
            background: #ffffff;
            padding: 8px 12px;
            border-radius: 50%;
            font-size: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .otp-label { 
            color: #3b82f6; 
            font-size: 14px; 
            font-weight: 600;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }
        .otp-code { 
            font-size: 42px; 
            font-weight: 700; 
            color: #1e40af; 
            letter-spacing: 12px;
            font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
            margin: 20px 0;
            padding: 16px 24px;
            background: #ffffff;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            display: inline-block;
        }
        .otp-expiry { 
            color: #dc2626; 
            font-size: 14px;
            font-weight: 500;
            margin-top: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .warning { 
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
            border: 1px solid #fecaca;
            border-left: 4px solid #dc2626;
            border-radius: 8px;
            padding: 20px;
            margin: 32px 0;
            color: #991b1b;
            font-size: 14px;
            line-height: 1.6;
        }
        .warning strong {
            color: #7f1d1d;
            font-weight: 600;
        }
        .footer { 
            background: linear-gradient(135deg, #1e40af 0%, #1e3a8a 100%);
            color: #ffffff;
            padding: 32px 40px;
            text-align: center;
            position: relative;
            z-index: 1;
        }
        .footer p { 
            margin: 8px 0;
            font-size: 14px;
            opacity: 1;
            color: #ffffff;
            position: relative;
            z-index: 2;
        }
        .footer p:first-child {
            font-weight: 500;
        }
        .divider { 
            height: 1px;
            background: linear-gradient(90deg, transparent 0%, #e2e8f0 20%, #e2e8f0 80%, transparent 100%);
            margin: 32px 0;
        }
        
        @media (max-width: 640px) {
            body { padding: 16px; }
            .header, .content, .footer { padding: 32px 24px; }
            .otp-container { padding: 32px 24px; }
            .otp-code { font-size: 36px; letter-spacing: 8px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo">The HESTIA</div>
            <p class="subtitle">Luxury Hotel &amp; Restaurant Platform</p>
        </div>
        
        <div class="content">
            <div class="greeting">Welcome <%= name %>!</div>
            
            <div class="message">
                Thank you for registering your hotel with The Hestia platform. 
                To complete your registration, please verify your email address using the verification code below:
            </div>
            
            <div class="otp-container">
                <div class="otp-label">Email Verification Code</div>
                <div class="otp-code"><%= otp %></div>
                <div class="otp-expiry">
                    <span>⏰</span>
                    <span>This code expires in 5 minutes</span>
                </div>
            </div>
            
            <div class="divider"></div>
            
            <div class="warning">
                <strong>Next Steps:</strong> After email verification, your hotel registration will be reviewed by our admin team. 
                You'll receive a confirmation email once approved.
            </div>
        </div>
        
        <div class="footer">
            <p>This is an automated message. Please do not reply to this email.</p>
            <p>&copy; <%= new Date().getFullYear() %> Hestia Hotel &amp; Restaurant Platform. All rights reserved.</p>
            <p>Building exceptional hospitality experiences</p>
        </div>
    </div>
</body>
</html>